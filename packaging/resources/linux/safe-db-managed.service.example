[Unit]
Description=safe-db managed launch example

[Service]
Type=simple
User=safe-db
ExecStart=/opt/safe-db/bin/safe-db --launch-profile /etc/safe-db/production.json
Restart=no

# The profile's protected password file should be owned by this service user
# with mode 0600. Do not place its contents in Environment= directives.

[Install]
WantedBy=default.target
